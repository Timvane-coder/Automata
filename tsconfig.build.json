{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "outDir": "lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "tsBuildInfoFile": "./lib/.tsbuildinfo"
  },
  "exclude": [
    "node_modules",
    "src/__tests__",
    "**/*.test.ts",
    "**/*.spec.ts",
    "Example/**/*",
    "lib"
  ]
}
